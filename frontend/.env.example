# ── Sutra Frontend – Environment Variables ──────────────────────────────
# Configure these variables in your Vercel Project Settings > Environment Variables.
# Only NEXT_PUBLIC_ variables are exposed to the browser.
# DO NOT include private backend API keys or service role secrets here.

# Backend API Base URL (Point to your live Render backend URL)
NEXT_PUBLIC_API_URL=https://sutra-1.onrender.com/api/v1

# Supabase Auth & Cloud Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Fallback mode (Set to false for real live forensic backend connectivity)
NEXT_PUBLIC_USE_MOCK_DATA=false
